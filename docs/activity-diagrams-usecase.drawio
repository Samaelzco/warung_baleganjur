<mxfile host="Electron" agent="Codex" pages="15">
  <diagram id="ad-01" name="01 Pemesanan QR Meja">
    <mxGraphModel dx="1885" dy="1036" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Activity Melakukan Pemesanan Melalui QR Meja\n\nskinparam defaultFontName Arial\nskinparam defaultFontSize 14\nskinparam activityFontSize 13\nskinparam swimlaneTitleFontSize 16\n\n|Customer|\nstart\n:Memindai QR Code meja;\n\n|Sistem|\n:Memvalidasi QR meja;\n\nif (Meja valid dan aktif?) then (Ya)\n    :Menampilkan menu dan addon;\nelse (Tidak)\n    :Menampilkan halaman tidak ditemukan;\n    stop\nendif\n\n|Customer|\n:Memilih menu dan addon;\n:Mengisi data pesanan;\n:Mengirim pesanan;\n\n|Sistem|\n:Memvalidasi pesanan;\n:Memeriksa kapasitas meja;\n\nif (Pesanan dapat diproses?) then (Tidak)\n    :Menampilkan pesan gagal atau arah waiting list;\n    stop\nelse (Ya)\n    :Menyimpan pesanan status menunggu;\n    :Menyinkronkan status meja;\n    |Customer|\n    :Melihat halaman status pesanan;\n    stop\nendif\n\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="BxRSCqYTpjOzGghNj8-7-1">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1">
            <mxGeometry height="872" width="966" x="130" y="30" as="geometry" />
          </mxCell>
        </UserObject>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="ad-02" name="02 Status Pesanan">
    <mxGraphModel dx="1664" dy="914" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Activity Melihat Status Pesanan\n\nskinparam defaultFontName Arial\nskinparam defaultFontSize 14\nskinparam activityFontSize 13\nskinparam swimlaneTitleFontSize 16\n\n|Customer|\nstart\n:Membuka halaman status pesanan;\n\n|Sistem|\n:Memvalidasi akses status;\n:Mengambil data pesanan;\n\nif (Pesanan ditemukan?) then (Ya)\n    :Menampilkan status pesanan;\nelse (Tidak)\n    :Menampilkan halaman tidak ditemukan;\n    stop\nendif\n\n|Customer|\n:Melihat status pesanan;\n\n|Sistem|\n:Memuat pembaruan status;\n\nif (Pesanan masih aktif?) then (Ya)\n    :Menampilkan status terbaru;\n    stop\nelse (Tidak)\n    :Menampilkan status akhir pesanan;\n    stop\nendif\n\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="XkC6mYdJGc34qoaELR_8-1">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1">
            <mxGeometry height="636" width="727" x="87" y="40" as="geometry" />
          </mxCell>
        </UserObject>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="ad-03" name="03 Mengubah Pesanan">
    <mxGraphModel dx="1571" dy="863" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Activity Mengubah Pesanan\n\nskinparam defaultFontName Arial\nskinparam defaultFontSize 14\nskinparam activityFontSize 13\nskinparam swimlaneTitleFontSize 16\n\n|Customer|\nstart\n:Memilih aksi ubah pesanan;\n\n|Sistem|\n:Memvalidasi akses dan status pesanan;\n\nif (Pesanan dapat diubah?) then (Ya)\n    :Menampilkan halaman ubah pesanan;\nelse (Tidak)\n    :Menampilkan pesan pesanan tidak dapat diubah;\n    stop\nendif\n\n|Customer|\n:Mengubah item pesanan;\n:Mengirim perubahan;\n\n|Sistem|\n:Memvalidasi perubahan;\n\nif (Perubahan valid?) then (Ya)\n    :Menghitung ulang total;\n    :Menyimpan perubahan pesanan;\n    :Menampilkan status terbaru;\n    stop\nelse (Tidak)\n    :Menampilkan error validasi;\n    stop\nendif\n\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="3mqhLf2SIUol-eSfjcs2-1">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1">
            <mxGeometry height="744" width="792" x="54" y="20" as="geometry" />
          </mxCell>
        </UserObject>
      </root>
    </mxGraphModel>
  </diagram>
