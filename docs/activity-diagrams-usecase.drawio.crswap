        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Activity Mengelola Pesanan\n\nskinparam defaultFontName Arial\nskinparam defaultFontSize 14\nskinparam activityFontSize 13\nskinparam swimlaneTitleFontSize 16\n\n|Admin/Kasir|\nstart\n:Membuka halaman pesanan;\n\n|Sistem|\n:Memeriksa permission pesanan;\n\nif (Akses diizinkan?) then (Ya)\n    :Menampilkan daftar pesanan;\nelse (Tidak)\n    :Menampilkan 403 Forbidden;\n    stop\nendif\n\n|Admin/Kasir|\n:Memilih aksi kelola pesanan;\n:Mengisi atau mengubah data pesanan;\n\n|Sistem|\n:Memvalidasi data pesanan;\n\nif (Data valid?) then (Ya)\n    :Menyimpan perubahan pesanan;\n    :Menampilkan pesan berhasil;\n    stop\nelse (Tidak)\n    :Menampilkan error validasi;\n    stop\nendif\n\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="jlorFnz-qJFLJWszCq9p-1">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1">
